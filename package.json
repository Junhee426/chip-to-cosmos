{
  "name": "chip-to-cosmos",
  "private": true,
  "version": "0.1.0",
  "description": "Chip to Cosmos \u2014 From Electrons to Orbital Networks. Multiscale interactive 3D scientific visualization.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "profile:beam": "VITE_PROFILE=1 vitest run tests/beam-profile.test.ts"
  },
  "license": "MIT",
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
